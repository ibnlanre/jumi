{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "moduleDetection": "auto",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    // tsup's declaration build injects `baseUrl` to resolve the `paths` below, and TypeScript 6
    // reports an injected deprecated option as an error (TS5101) even though this file never sets
    // one. The flag is TypeScript's own advice in that message, and it is a bridge: TypeScript 7
    // removes both the option and the silencer, at which point the injection has to go rather than be
    // hidden behind this.
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": false,
    "noUncheckedSideEffectImports": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    },
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "es2022",
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", "build", "coverage", "examples"],
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "docs/.astro/types.d.ts",
    ".storybook/**/*.ts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "tsup.config.ts"
  ],
  "extends": "astro/tsconfigs/base"
}
