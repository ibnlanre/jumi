---
import Layout from './Layout.astro'
import { version } from '../data/version.json'
const { frontmatter } = Astro.props
const links = [
  ['/docs/', 'Introduction'],
  ['/docs/installation/', 'Installation'],
  ['/docs/build-step/', 'The build step'],
  ['/docs/properties/', 'Composing motion'],
  ['/docs/reveals/', 'Reveals & exits'],
  ['/docs/controls/', 'Timing & controls'],
  ['/docs/stagger/', 'Stagger'],
  ['/docs/transitions/', 'Transitions'],
  ['/docs/view-transitions/', 'View transitions'],
  ['/docs/same-document-transitions/', 'Same-document'],
  ['/docs/accessibility/', 'Accessible motion'],
  ['/effects/', 'Effect catalog ↗'],
]
---

<Layout
  title={`${frontmatter.title} — Jumi`}
  description={frontmatter.description}
  docs
>
  <div class='docs-shell'>
    <aside class='docs-sidebar'>
      <p class='eyebrow'>THE FIELD GUIDE</p>
      <nav aria-label='Documentation'>
        {links.map(([href, label]) => (
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class='sidebar-note'>
        Small classes.
        <br />
        Big possibilities.<span>JUMI / {version}</span>
      </div>
    </aside>
    <main
      id='main'
      class='docs-content'
    >
      <p class='eyebrow'>DOCUMENTATION</p>
      <h1>{frontmatter.title}</h1>
      <p class='docs-lede'>{frontmatter.description}</p>
      <div class='prose'>
        <slot />
      </div>
      <a
        class='text-link'
        href='https://github.com/ibnlanre/jumi/tree/main/docs'
      >
        Improve these docs ↗
      </a>
    </main>
  </div>
  <script>
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
      // The frame owns the button; only the `pre` scrolls. Appended to the `pre` — which is what this
      // did — the button is a child of the scroller, so it travelled with the code the moment a line was
      // wider than the column: the screenshot case, and the reason the wrapper exists.
      const frame = document.createElement('div')
      frame.className = 'code-frame'
      pre.replaceWith(frame)
      frame.append(pre)

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'copy-code'
      button.textContent = 'Copy'
      button.setAttribute('aria-label', 'Copy code example')
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(
            pre.querySelector('code')?.textContent || '',
          )
          button.textContent = 'Copied!'
        } catch {
          button.textContent = 'Select code to copy'
        }
        setTimeout(() => (button.textContent = 'Copy'), 1800)
      })
      frame.append(button)
    })
  </script>
</Layout>
