---
import Layout from '../layouts/Layout.astro'
import '../styles/motion.css'
import effects from '../data/effects.json'
---

<Layout>
  <main id='main'>
    <section class='hero'>
      <div class='eyebrow'>
        <span class='cross'>✳</span> THE ATOMIC MOTION LIBRARY
      </div>
      <h1>
        Give your
        <br />
        interface <em>life.</em>
      </h1>
      <div class='hero-bottom'>
        <p>
          Big motion. Small classes.
          <br />
          Compose expressive animations right in your markup, with the Tailwind
          CSS you already know.
        </p>
        <a
          class='button lime'
          href='/docs/'
        >
          Start moving <span>↗</span>
        </a>
      </div>
      <div
        class='hero-art'
        aria-hidden='true'
      >
        <div class='orbit animate-rotate-360 animation-duration-[24s] animation-timing-function-linear animation-iteration-count-infinite'>
          {Array.from({ length: 12 }, (_, i) => (
            <div
              class='petal-position
                animate-rotate-[0:var(--angle)|100:calc(var(--angle)_-_360deg)]
                animation-duration-[75s]
                animation-timing-function-linear
                animation-iteration-count-infinite'
              style={`--angle:${i * 30}deg`}
            >
              <div
                class='petal
                  animate-rotate-[0:0deg|20:-8deg|100:-8deg]/flick
                  animate-rotate-[0:0deg|20:0deg|100:8deg]/return
                  animation-composition-add/rotate
                  animation-duration-[3000ms]
                  animation-timing-function-[cubic-bezier(.4,0,.6,1)]/flick
                  animation-timing-function-linear/return
                  animation-iteration-count-infinite'
                style={`--jumi-animation-delay:${i * -250}ms`}
              ></div>
            </div>
          ))}
          <span class='orbit-core'></span>
        </div>
        <span class='art-coordinate top'>FIG. 01 / COMPOSITION</span>
        <span class='art-coordinate bottom'>12 PARTS. ONE SHARED RHYTHM.</span>
      </div>
      <div class='hero-index'>01: A LITTLE CLASS. A LOT OF CHARACTER.</div>
    </section>
    <div class='ticker'>
      <span>{effects.length} effects</span>
      <i>✳</i>
      <span>Composable by nature</span>
      <i>✳</i>
      <span>No animation runtime</span>
      <i>✳</i>
      <span>Powered by CSS</span>
      <i>✳</i>
    </div>
    <section class='studies section'>
      <div class='section-heading'>
        <div>
          <p class='eyebrow'>MOTION STUDIES / 001-003</p>
          <h2>
            Less setup.
            <br />
            More <em>expression.</em>
          </h2>
        </div>
        <p>
          Pick an effect. Give it a rhythm.
          <br />
          Make something that feels like you.
        </p>
      </div>
      <div class='study-grid'>
        <article
          class='study'
          data-demo
        >
          <div class='study-label'>
            <span>01 / ENTRANCE</span>
            <button
              data-replay
              aria-label='Replay entrance'
            >
              ↻
            </button>
          </div>
          <div class='stage apricot'>
            <div class='study-word animate-bounce-in animation-duration-[1200ms]'>
              hey.
            </div>
          </div>
          <div class='study-caption'>
            <h3>Make an entrance.</h3>
            <code>animate-bounce-in</code>
          </div>
        </article>
        <article
          class='study'
          data-demo
        >
          <div class='study-label'>
            <span>02 / COMPOSITION</span>
            <button
              data-replay
              aria-label='Replay composition'
            >
              ↻
            </button>
          </div>
          <div class='stage lilac'>
            <div class='tile-stack animate-rotate-[180deg] animation-duration-[6s] animation-direction-alternate animation-iteration-count-infinite animation-timing-function-ease-in-out'>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
          <div class='study-caption'>
            <h3>Find your rhythm.</h3>
            <code>animate-rotate-[180deg]</code>
          </div>
        </article>
        <article
          class='study'
          data-demo
        >
          <div class='study-label'>
            <span>03 / STAGGER</span>
            <button
              data-replay
              aria-label='Replay stagger'
            >
              ↻
            </button>
          </div>
          <div class='stage green'>
            <div class='bars animate-stagger-forward-[120ms]/7 *:animate-scale-y-[0.2] *:animation-duration-[1100ms] *:animation-direction-alternate *:animation-iteration-count-infinite *:animation-timing-function-ease-in-out'>
              {Array.from({ length: 7 }, () => (
                <i></i>
              ))}
            </div>
          </div>
          <div class='study-caption'>
            <h3>Start a chain reaction.</h3>
            <code>animate-stagger-forward-[120ms]/7</code>
          </div>
        </article>
      </div>
      <a
        class='text-link'
        href='/effects/'
      >
        Meet all {effects.length} effects <span>↗</span>
      </a>
    </section>
    <section class='anatomy section'>
      <div>
        <p class='eyebrow'>SMALL PIECES. INFINITE PERSONALITY.</p>
        <h2>
          Motion,
          <br />
          <em>atom by atom.</em>
        </h2>
        <p class='body-copy'>
          An effect is only the beginning. Layer properties, give each one its
          own timing, and let Jumi assemble the CSS.
        </p>
        <a
          class='text-link'
          href='/docs/properties/'
        >
          Learn to compose ↗
        </a>
      </div>
      <div class='code-exhibit'>
        <div class='code-top'>
          <span>YOUR FIRST COMPOSITION</span>
          <span>HTML</span>
        </div>
        <pre><code>&lt;div class="<span class="syntax-lime">animate-rotate-45
  animate-scale-110</span>
  <span class="syntax-peach">animation-duration-[800ms]/rotate
  animation-duration-[1200ms]/scale</span>
  <span class="syntax-lilac">animation-direction-alternate
  animation-iteration-count-infinite</span>"&gt;
  Make your move.
&lt;/div&gt;</code></pre>
        <div class='code-legend'>
          <span>01 Compose</span>
          <span>02 Control</span>
        </div>
      </div>
    </section>
    <section class='closing section'>
      <p class='eyebrow'>YOUR NEXT IDEA DESERVES TO MOVE.</p>
      <h2>
        Static is
        <br />
        <em>just the start.</em>
      </h2>
      <div class='install'>
        <code>pnpm add @ibnlanre/jumi</code>
        <button
          data-copy='pnpm add @ibnlanre/jumi'
          aria-label='Copy install command'
        >
          Copy
        </button>
      </div>
      <a
        class='text-link'
        href='/docs/'
      >
        Read the documentation ↗
      </a>
    </section>
  </main>
</Layout>
