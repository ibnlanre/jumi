---
import Layout from '../../layouts/Layout.astro'
---

<Layout title='Details | Jumi motion studies'>
  <main style='padding:8rem 5vw;max-width:1100px;margin:auto'>
    <p>JUMI / DETAILS</p>
    <h1 style='font-size:clamp(3rem,7vw,6rem);line-height:1.05;margin:2rem 0'>
      Motion, studied.
    </h1>
    <p style='max-width:38rem;margin-bottom:3rem'>
      Independent studies of exceptional websites. Real assets, observed
      interactions, public Jumi primitives, and an honest account of their
      limits.
    </p>
    <a
      href='/details/zetta-joule/'
      style='display:block;background:linear-gradient(#6c8acb,#fcf0e1);padding:3rem;color:white;overflow:hidden'
    >
      <img
        src='/details/zetta-joule/hero.webp'
        alt='ZettaJoule reactor'
        style='float:right;width:35%;max-height:300px;object-fit:cover;object-position:top'
      />
      <p>01 / MOTION STUDY</p>
      <h2 style='font-size:3rem;margin:1rem 0'>ZettaJoule ↗</h2>
      <p>Editorial entrances · clipped film · pinned reactor</p>
    </a>
  </main>
</Layout>
