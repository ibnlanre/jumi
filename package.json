{
  "name": "jumi",
  "version": "2.0.0",
  "description": "A comprehensive CSS animation library built as a TailwindCSS plugin",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:dev": "astro dev --root docs",
    "docs:build": "pnpm run bundle && pnpm run docs:prepare && astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "css:snapshot": "node scripts/css-snapshot.mjs --update",
    "css:check": "node scripts/css-snapshot.mjs --check",
    "theme:map": "node scripts/theme-map.mjs",
    "incremental:check": "node scripts/incremental-build.mjs",
    "lint": "eslint --fix .",
    "bundle": "tsup src/index.ts --format cjs,esm --dts",
    "watch-bundle": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build": "pnpm run bundle && pnpm run examples:build",
    "examples:build": "node scripts/build-examples.mjs",
    "prepublishOnly": "pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "node scripts/analyze.js",
    "behaviour:check": "node scripts/behaviour-check.mjs",
    "spike:carrier-seam": "node scripts/spike-carrier-seam.mjs",
    "spike:carrier-finalize": "node scripts/spike-carrier-finalize.mjs",
    "check": "pnpm run check-types && pnpm exec eslint src scripts && pnpm run test:run && pnpm run css:check && pnpm run incremental:check && pnpm run behaviour:check"
  },
  "keywords": [
    "tailwindcss",
    "animation",
    "css",
    "plugin",
    "transforms",
    "effects",
    "composable",
    "typescript"
  ],
  "author": "Ridwan Olanrewaju",
  "license": "MIT",
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@storybook/addon-a11y": "^10.0.7",
    "@storybook/addon-docs": "^10.0.7",
    "@storybook/addon-onboarding": "^10.0.7",
    "@storybook/addon-themes": "^10.0.7",
    "@storybook/addon-vitest": "^10.0.7",
    "@storybook/react": "^10.0.7",
    "@storybook/react-vite": "^10.0.7",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.1.17",
    "@types/css.escape": "^1.5.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "4.0.9",
    "@vitest/eslint-plugin": "^1.4.2",
    "astro": "^5.18.2",
    "css.escape": "^1.5.1",
    "csstype": "^3.2.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-paths": "^1.1.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^10.0.7",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "jiti": "^2.6.1",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.0.7",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.9"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ibnlanre/jumi"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "glob": "^11.0.3",
    "shorthash2": "^1.0.5"
  }
}
