{
  "name": "@ibnlanre/jumi",
  "version": "0.1.0",
  "description": "A comprehensive CSS animation library built as a TailwindCSS plugin",
  "packageManager": "pnpm@9.14.4",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postcss": {
      "import": {
        "types": "./dist/postcss.d.ts",
        "default": "./dist/postcss.js"
      },
      "require": {
        "types": "./dist/postcss.d.cts",
        "default": "./dist/postcss.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./view-transition": {
      "import": {
        "types": "./dist/view-transition.d.ts",
        "default": "./dist/view-transition.js"
      },
      "require": {
        "types": "./dist/view-transition.d.cts",
        "default": "./dist/view-transition.cjs"
      }
    }
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "changelog": "node scripts/changelog.mjs",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:minor": "pnpm version minor --no-git-tag-version",
    "release:major": "pnpm version major --no-git-tag-version",
    "stories:prepare": "node scripts/prepare-stories.mjs",
    "studio:check": "pnpm run docs:build && node scripts/studio-check.mjs",
    "stories:check": "node scripts/stories-check.mjs",
    "docs:dev": "astro dev --root docs",
    "docs:build": "pnpm run bundle && pnpm run docs:prepare && astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "css:snapshot": "node scripts/css-snapshot.mjs --update",
    "css:check": "node scripts/phantom-candidates.mjs && node scripts/css-snapshot.mjs --check && node scripts/dead-links.mjs --strict && node scripts/serialize-audit.mjs && node scripts/serialize-differential.mjs",
    "constituent:check": "node scripts/constituent-check.mjs",
    "theme:map": "node scripts/theme-map.mjs",
    "incremental:check": "node scripts/incremental-build.mjs",
    "lint": "eslint --fix .",
    "bundle": "node scripts/bundle.mjs",
    "watch-bundle": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build": "pnpm run bundle && pnpm run examples:build",
    "examples:build": "node scripts/build-examples.mjs",
    "prepublishOnly": "pnpm run build",
    "check-types": "tsc --noEmit",
    "legacy:check": "node scripts/legacy-carrier-check.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "node scripts/analyze.js",
    "behaviour:check": "node scripts/behaviour-check.mjs",
    "effects:check": "node scripts/effect-candidates-check.mjs",
    "view-transition:check": "node scripts/view-transition-check.mjs",
    "scroll-driven:check": "node scripts/scroll-driven-check.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "vite:check": "node scripts/vite-check.mjs",
    "postcss:check": "node scripts/postcss-check.mjs",
    "consumer:check": "node scripts/consumer-check.mjs",
    "spike:candidates": "node scripts/spike-candidates.mjs",
    "spike:variants": "node scripts/spike-variants.mjs",
    "spike:view-transitions": "node scripts/spike-view-transitions.mjs",
    "spike:vt-syntax": "node scripts/spike-vt-syntax.mjs",
    "spike:vt-concurrency": "node scripts/spike-vt-concurrency.mjs",
    "spike:scroll-driven": "node scripts/spike-scroll-driven.mjs",
    "spike:scroll-variant": "node scripts/spike-scroll-variant.mjs",
    "spike:motion-paths": "node scripts/spike-motion-paths.mjs",
    "phrase:check": "node scripts/phrase-check.mjs",
    "spike:entry-exit": "node scripts/spike-entry-exit.mjs",
    "spike:discrete-keyframes": "node scripts/spike-discrete-keyframes.mjs",
    "spike:inventory": "node scripts/spike-motion-inventory.mjs",
    "spike:named-timelines": "node scripts/spike-named-timelines.mjs",
    "spike:surface-audit": "node scripts/spike-surface-audit.mjs",
    "hardening:audit": "node scripts/hardening-audit.mjs",
    "spike:intrinsic-layout": "node scripts/spike-intrinsic-layout.mjs",
    "spike:cdp-cost": "node scripts/spike-cdp-cost.mjs",
    "spike:local-list": "node scripts/spike-local-list.mjs",
    "spike:addressing": "node scripts/spike-addressing.mjs",
    "spike:instances": "node scripts/spike-instance-models.mjs",
    "spike:segments": "node scripts/spike-segment-easing.mjs",
    "spike:timing-phrase": "node scripts/spike-timing-phrase.mjs",
    "spike:label-link": "node scripts/spike-label-link.mjs",
    "spike:slot-key": "node scripts/spike-slot-key.mjs",
    "spike:slot-boundary": "node scripts/spike-slot-boundary.mjs",
    "spike:recalc": "node scripts/spike-recalc.mjs",
    "measure:real-page": "node scripts/measure-real-page.mjs",
    "spike:real-page": "node scripts/spike-real-page.mjs",
    "spike:variable-animation": "node scripts/spike-variable-animation.mjs",
    "spike:property-typing": "node scripts/spike-property-typing.mjs",
    "spike:aggregate-order": "node scripts/spike-aggregate-order.mjs",
    "spike:transform-interpolation": "node scripts/spike-transform-interpolation.mjs",
    "spike:typed-leaves": "node scripts/spike-typed-leaves.mjs",
    "research:aggregate-offsets": "node scripts/research/aggregate-offsets.mjs",
    "research:batching-eligibility": "node scripts/research/batching-eligibility.mjs",
    "research:cross-element": "node scripts/research/cross-element-isolation.mjs",
    "research:d2-acceptance": "node scripts/research/d2-acceptance.mjs",
    "research:d3-reach": "node scripts/research/d3-reach.mjs",
    "research:d3-interpolation": "node scripts/research/d3-interpolation.mjs",
    "research:d3-observation": "node scripts/research/d3-observation.mjs",
    "research:d3-coverage": "node scripts/research/d3-coverage.mjs",
    "research:d3-projection": "node scripts/research/d3-projection.mjs",
    "research:d3-crosstab": "node scripts/research/d3-crosstab.mjs",
    "research:d3-derivation": "node scripts/research/d3-derivation.mjs",
    "research:d3-validation": "node scripts/research/d3-validation.mjs",
    "research:d3-argument": "node scripts/research/d3-argument.mjs",
    "research:d3-anchor": "node scripts/research/d3-anchor.mjs",
    "research:d3-authoring-routes": "node scripts/research/d3-authoring-routes.mjs",
    "research:d3-function-shell": "node scripts/research/d3-function-shell.mjs",
    "research:d3-residual": "node scripts/research/d3-residual.mjs",
    "research:d3-anchor-normal": "node scripts/research/d3-anchor-normal.mjs",
    "research:d3-position-necessity": "node scripts/research/d3-position-necessity.mjs",
    "research:d3-offset-leaf": "node scripts/research/d3-offset-leaf.mjs",
    "research:d3-fallback-arms": "node scripts/research/d3-fallback-arms.mjs",
    "research:d3-resolved-axis": "node scripts/research/d3-resolved-axis.mjs",
    "research:identity-collision": "node scripts/research/identity-collision.mjs",
    "candidate:diff": "node scripts/candidate-diff.mjs",
    "check": "node scripts/check.mjs",
    "check:only": "node scripts/check.mjs"
  },
  "keywords": [
    "tailwindcss",
    "animation",
    "css",
    "plugin",
    "transforms",
    "effects",
    "composable",
    "typescript"
  ],
  "author": "Ridwan Olanrewaju",
  "license": "MIT",
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.2.0 || ^6 || ^7 || ^8"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/css.escape": "^1.5.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "astro": "^7.3.3",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "css.escape": "^1.5.1",
    "csstype": "^3.2.3",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-paths": "^1.1.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.6.0",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibnlanre/jumi.git"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "shorthash2": "^1.0.5"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
